# Application
VHOME_ENV=development

# HTTP server
VHOME_HTTP_ADDR=:8080
VHOME_HTTP_READ_HEADER_TIMEOUT=5s
VHOME_HTTP_READ_TIMEOUT=15s
VHOME_HTTP_WRITE_TIMEOUT=15s
VHOME_HTTP_IDLE_TIMEOUT=60s
VHOME_HTTP_SHUTDOWN_TIMEOUT=10s

# MySQL connection
VHOME_DB_HOST=127.0.0.1
VHOME_DB_PORT=3306
VHOME_DB_USER=vhome
VHOME_DB_PASSWORD=vhome-password
VHOME_DB_NAME=vhome
VHOME_DB_LOCATION=Asia/Shanghai

# MySQL connection pool
VHOME_DB_MAX_OPEN_CONNS=20
VHOME_DB_MAX_IDLE_CONNS=10
VHOME_DB_CONN_MAX_LIFETIME=3m
VHOME_DB_CONN_MAX_IDLE_TIME=1m

# MySQL timeout
VHOME_DB_CONNECT_TIMEOUT=5s
VHOME_DB_READ_TIMEOUT=5s
VHOME_DB_WRITE_TIMEOUT=5s

# Authentication
VHOME_AUTH_SESSION_TTL=336h
VHOME_AUTH_COOKIE_NAME=vhome_session
VHOME_AUTH_COOKIE_SECURE=false