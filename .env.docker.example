# Browser entry and host-side MySQL port.
VHOME_WEB_PORT=5173
VHOME_MYSQL_HOST_PORT=3307

# MySQL database and credentials. Replace both example passwords.
VHOME_MYSQL_DATABASE=vhome
VHOME_MYSQL_USER=vhome
VHOME_MYSQL_PASSWORD=replace-with-a-long-random-password
VHOME_MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# Base64-encoded 32-byte AES key. Generate once with: openssl rand -base64 32
# Never change or lose this after saving SMTP/SMS credentials.
VHOME_SECRET_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32-output

# Direct HTTP access defaults. When an HTTPS reverse proxy is configured,
# change these to production and true.
VHOME_ENV=development
VHOME_AUTH_COOKIE_SECURE=false

# Optional LLM providers. applyEnv loads a provider only when API key, model,
# and base URL are all non-empty. Leave blank to skip that provider at boot.
DEEPSEEK_APIKEY=
DEEPSEEK_MODEL=deepseek-v4
DEEPSEEK_BASEURL=https://api.deepseek.com
GLM_APIKEY=
GLM_MODEL=
GLM_BASEURL=
